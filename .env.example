# Backend
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_INTERVIEW_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_VOICE_API=http://localhost:8080

# Optional Simli avatar (backend only; never expose the primary key to the frontend)
SIMLI_ENABLED=true
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_MAX_SESSION_SECONDS=1800
SIMLI_MAX_IDLE_SECONDS=300
AVATAR_PROVIDER=simli
